# Copy to .env and fill in. .env is not in git.
#
#   cp .env.example .env
#
# MQTT_PASSWORD has to be the same password you gave mosquitto_passwd for the
# MQTT_USER below - the broker only knows the hash, so it cannot be read back.

# Who may reach the plain 1883 listener. 0.0.0.0 on a development machine so a
# board on the LAN can connect; 127.0.0.1 on a server facing the internet, so
# that the only way in from outside is 8883 with TLS.
MQTT_BIND=0.0.0.0

POSTGRES_PASSWORD=
MQTT_USER=boathub
MQTT_PASSWORD=
GRAFANA_PASSWORD=

{
  "uid": "boathub-sensors",
  "title": "BoatHub - sensors",
  "tags": [
    "boathub"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Battery voltage",
      "description": "Mean over each 5 min window, with the range behind it. The shaded band is where the compressor and the bilge pump show up - the mean alone would hide them. AGM thresholds: 12.3 V is about 50 %, 12.0 V about 30 %.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, battery_v AS mean, battery_v_min AS min, battery_v_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND battery_v IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bilge level",
      "description": "A rising mean is the slow leak; a rising max with a flat mean is the pump cycling. Empty until the 4-20 mA probe is fitted.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, bilge_level_cm AS mean, bilge_level_cm_min AS min, bilge_level_cm_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND bilge_level_cm IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Temperatures",
      "description": "Mean per window, every temperature the boat measures on one axis: the cabin air (SHT31), the battery bay's air (BME680) and the three probes. Engine bay rising is also the clearest sign the engine is running. A sensor that is not fitted has no line.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, cabin_temp_c AS \"cabin\", bay_temp_c AS \"battery bay\", engine_temp_c AS \"engine bay\", bilge_temp_c AS \"bilge water\", fridge_temp_c AS \"fridge\" FROM telemetry WHERE $__timeFilter(received_at) AND (cabin_temp_c IS NOT NULL OR bay_temp_c IS NOT NULL OR engine_temp_c IS NOT NULL OR bilge_temp_c IS NOT NULL OR fridge_temp_c IS NOT NULL) ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fridge",
      "description": "Mean with the range behind it. The band is the compressor cycle, and its width is what tells you the duty cycle - the single number that dominates consumption away from the dock.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, fridge_temp_c AS mean, fridge_temp_c_min AS min, fridge_temp_c_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND fridge_temp_c IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Engine bay",
      "description": "Mean with the range behind it. The width of the band is what separates a bay warming slowly in the sun from one heated by a running engine, which moves several degrees inside a single window.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, engine_temp_c AS mean, engine_temp_c_min AS min, engine_temp_c_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND engine_temp_c IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bilge water",
      "description": "Mean with the range behind it. Bilge water has a large thermal mass and moves slowly, so a wide band is a probe being splashed or a pump running rather than the water changing temperature.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, bilge_temp_c AS mean, bilge_temp_c_min AS min, bilge_temp_c_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND bilge_temp_c IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cabin temperature",
      "description": "Mean with the range behind it. Empty until the SHT31 is wired.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, cabin_temp_c AS mean, cabin_temp_c_min AS min, cabin_temp_c_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND cabin_temp_c IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cabin humidity",
      "description": "Sustained high humidity is the condensation and mould warning. Relative humidity depends on temperature, which is why the sensor belongs in cabin air and not inside the enclosure.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, cabin_rh AS mean, cabin_rh_min AS min, cabin_rh_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND cabin_rh IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heel",
      "description": "Mean over each 5 min window, positive to starboard, with the range behind it. The mean is how she lies: one that keeps drifting at the berth is water coming in, or a boat hanging in her lines on a falling tide. The band is the single largest roll - one wake, one gust. Empty until the boat has been levelled on the portal.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, heel_deg AS mean, heel_deg_min AS min, heel_deg_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND heel_deg IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trim",
      "description": "Pitch, positive bow-up: mean over each window with the range behind it. At rest the mean is the trim, and water collecting aft or forward shows here first. Empty until the boat has been levelled.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, pitch_deg AS mean, pitch_deg_min AS min, pitch_deg_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND pitch_deg IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rolling and pitching",
      "description": "Standard deviation within each window: how much she moves, typically. A steady roll of plus or minus 5 degrees reads about 3.5. The bands above are set by single events; this is set by the whole five minutes - together they tell restless from once, hard.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, heel_deg_sd AS roll, pitch_deg_sd AS pitch FROM telemetry WHERE $__timeFilter(received_at) AND heel_deg_sd IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Motion and knocks",
      "description": "How hard she is thrown about: acceleration less gravity, as the mean and the hardest jolt in each window - including the up and down that no angle shows. The bars are knocks the IMU detected. While the knock threshold is being set, these are the record to set it against (A-009 section 7).",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "accG",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "knocks"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.fillOpacity",
                "value": 60
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, motion_g AS mean, motion_g_max AS max, knocks FROM telemetry WHERE $__timeFilter(received_at) AND motion_g IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Barometer",
      "description": "Station pressure at the sensor's own height, as the board sends it: the mean over each window, with its range. A weather report gives sea level instead, higher by about 0.12 hPa for every metre of height - the panel beside it. The absolute figure is good to half a hectopascal; what this sensor is for is the trend, on the right.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS time, pressure_hpa AS mean, pressure_hpa_min AS min, pressure_hpa_max AS max FROM telemetry WHERE $__timeFilter(received_at) AND pressure_hpa IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sea-level pressure",
      "description": "Station pressure reduced to sea level with the boat's height from the boats table - the figure a weather report or a synoptic chart gives, and the one to calibrate the board's offset against (A-010 section 11). The height is applied as the panel draws, so correcting it redraws the whole history and changes nothing stored. Empty until the boat's height is set; server/README.md has the statement.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.received_at AS time, t.pressure_hpa / b.f AS mean, t.pressure_hpa_min / b.f AS min, t.pressure_hpa_max / b.f AS max FROM telemetry t JOIN (SELECT boat_id, power(1 - 0.0065 * height_m / 288.15, 5.255) AS f FROM boats) b USING (boat_id) WHERE $__timeFilter(t.received_at) AND t.pressure_hpa IS NOT NULL ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pressure tendency, 3 h",
      "description": "Each window's pressure minus the one three hours before it, by the board's own clock - so a backlog uploaded after a passage shows the trend as it happened, not all at once on arrival. A fall of 3 hPa or more in three hours, the dashed line, is the classic warning sign. Neither the height nor the board's offset matters here: both cancel in a difference. Empty until three hours of readings exist.",
      "datasource": {
        "type": "postgres",
        "uid": "boathub"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": -3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, tendency AS \"3 h tendency\" FROM (SELECT ts AS time, pressure_hpa - first_value(pressure_hpa) OVER w AS tendency, ts - first_value(ts) OVER w AS span FROM telemetry WHERE pressure_hpa IS NOT NULL AND ts IS NOT NULL AND ts >= $__timeFrom()::timestamptz - INTERVAL '3 hours' AND ts <= $__timeTo()::timestamptz WINDOW w AS (PARTITION BY boat_id ORDER BY ts RANGE BETWEEN INTERVAL '3 hours' PRECEDING AND CURRENT ROW)) t WHERE $__timeFilter(time) AND span >= INTERVAL '2 hours 50 minutes' ORDER BY 1"
        }
      ]
    },

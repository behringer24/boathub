# --- Secrets: never in the repository ---
secrets.h
secrets.ini
*credentials*
.env
.env.*
!.env.example

# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/

# --- Arduino IDE ---
build/
*.bin
*.elf
*.map

# --- KiCad: local view state, backups, locks and generated output ---
*.kicad_prl
*.bak
*-backups/
~*.lck
hardware/*/production/
hardware/*/*.rpt

# --- FreeCAD: the document and the meshes are both generated by the script ---
*.FCStd
*.FCStd1
hardware/*/export/

# --- Python bytecode, from anything that imports or execs a script ---
__pycache__/
*.pyc

# --- Editor / IDE ---
.vscode/
!.vscode/extensions.json
.idea/
.history/
*.swp
*~

# --- Operating system ---
Thumbs.db
desktop.ini
.DS_Store

# --- Logs ---
*.log

# --- Local progress tracking, not documentation ---
PROGRESS.md

# --- MQTT broker credentials (hashes, but still not ours to publish) ---
server/mosquitto/config/passwd

# --- Go build output ---
server/ingest/ingest
server/ingest/ingest.exe

# --- Working conventions for this repository, local only ---
CLAUDE.md
